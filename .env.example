# ==========================================
# SyncBrief AI — Environment Configuration
# Microsoft Innovate 2026 Hackathon Demo
# ==========================================

# 1. AI Provider Configuration
# Leave blank to use the built-in Deterministic Demo AI (Offline mode works 100% without keys)
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_KEY=""
AZURE_OPENAI_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_API_VERSION="2024-08-01-preview"

# 2. Microsoft Teams Bot Framework & Webhooks
# Optional: set incoming webhook to broadcast standup digests to live Microsoft Teams channels
TEAMS_WEBHOOK_URL=""
TEAMS_APP_ID=""
TEAMS_APP_PASSWORD=""

# 3. Azure DevOps REST API
# Optional: Personal Access Token with Work Items (Read & Write) scope
AZURE_DEVOPS_ORG="contoso-innovate"
AZURE_DEVOPS_PROJECT="SyncBrief-Core"
AZURE_DEVOPS_PAT=""

# 4. Security & Storage
SECRET_KEY="syncbrief-hackathon-2026-secret-jwt-key"
DATABASE_URL="sqlite:///./syncbrief.db"
