# ==========================================
# SyncBrief AI — Environment Configuration
# Enterprise Work Intelligence Platform
# ==========================================

# 1. AI Provider Configuration
# Groq Cloud AI (Real-Time Ultra-Fast Inference)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Azure OpenAI (Optional alternate cloud LLM)
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_KEY=""
AZURE_OPENAI_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_API_VERSION="2024-08-01-preview"

# 2. Microsoft Teams Bot Framework & Webhooks
# Optional: set incoming webhook to broadcast standup digests to live Microsoft Teams channels
TEAMS_WEBHOOK_URL=""
TEAMS_APP_ID=""
TEAMS_APP_PASSWORD=""

# 3. Azure DevOps REST API
# Optional: Personal Access Token with Work Items (Read & Write) scope
AZURE_DEVOPS_ORG="contoso-workspace"
AZURE_DEVOPS_PROJECT="SyncBrief-Core"
AZURE_DEVOPS_PAT=""

# 4. Security & Storage
SECRET_KEY="syncbrief-enterprise-secret-jwt-key"
DATABASE_URL="sqlite:///./syncbrief.db"

# 5. Social / Enterprise SSO Authentication (Google & Microsoft Identity)
# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional custom redirect URI (defaults to ${OAUTH_REDIRECT_BASE_URL}/auth/callback)
GOOGLE_REDIRECT_URI=""

# Microsoft Entra ID / Microsoft Identity (from Azure Portal -> Microsoft Entra ID -> App Registrations)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
# Optional custom redirect URI (defaults to ${OAUTH_REDIRECT_BASE_URL}/auth/callback)
MICROSOFT_REDIRECT_URI=""

# Front-end Base URL for OAuth Callbacks (e.g. http://localhost:5173 in dev)
OAUTH_REDIRECT_BASE_URL="http://localhost:5173"

